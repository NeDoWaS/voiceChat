@page "/homePage"
@using System.Net.Http.Json
@using VoiceChat.Client.Models;
@using static System.Collections.IEnumerable;
@using VoiceChat.Client.Services;
@using Microsoft.AspNetCore.Http.HttpResults;

@inject HttpClient Http
@inject NavigationManager Navigation
@inject VoiceChat.Client.Services.ApiService ApiService
@rendermode InteractiveServer

<PageTitle>VoiceChat</PageTitle>

<div class="home-page">

    <div class="header">
        <div>
            <h1>VoiceChat</h1>
            <p>Choose a room to join</p>
        </div>

        <button class="refresh-button" @onclick="LoadRooms">
            Refresh
        </button>
    </div>

    @if (loading)
    {
        <div class="status">
            Loading rooms...
        </div>
    }
    else if (!string.IsNullOrEmpty(error))
    {
        <div class="status error">
            @error
        </div>
    }
    else if (rooms.Count == 0)
    {
        <div class="status">
            No rooms available.
        </div>
    }
    else
    {
        <div class="rooms-grid">
            @foreach (var room in rooms)
            {
                <button class="room-card" @onclick="() => NavigateToRoomComponent(room.Id)">
                    <div class="room-icon">
                        🎧
                    </div>

                    <div class="room-info">
                        <h2>@room.Name</h2>

                        @if (!string.IsNullOrWhiteSpace(room.Description))
                        {
                            <p>@room.Description</p>
                        }
                        else
                        {
                            <p>No description</p>
                        }
                    </div>

                    <div class="arrow">
                        →
                    </div>
                </button>
            }
        </div>
    }
</div>
@code {

        //public VoiceChat.Client.Services.ApiService ApiService { get; set; } = default!;
        private bool loading = true;
        //private int roomId = 0;
        //private string roomName { get; set; } = string.Empty;
        private string? error;

        public List<Models.Room> rooms = new List<Models.Room>();


        // Логика создания комнаты


        protected override async Task OnInitializedAsync()
        {
            await LoadRooms();
        }


        private void CreateRoom(string roomName, int ownerId, string description = "")
        {
            if (!string.IsNullOrWhiteSpace(roomName))
            {
                rooms.Add(new Models.Room(roomName, 0, ""));
                ApiService.CreateRoomAsync(roomName, 0, "").Wait();
                Console.WriteLine($"Room {roomName} was created! ");

                roomName = string.Empty;
                StateHasChanged();
            }

        }
        private async Task NavigateToRoomComponent(int roomId)
        {
            Navigation.NavigateTo($"/room/{roomId}");
            Console.WriteLine($"Navigating to room {roomId}...");
        }
        private async Task<List<Models.Room>> LoadRooms()
        {
            rooms = await ApiService.GetRoomsAsync();
            loading = false;
            StateHasChanged();

            return rooms;
        }
}

