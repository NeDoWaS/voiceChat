@page "/homePage"

@using VoiceChat.Client.Models
@using VoiceChat.Client.Services

@inject NavigationManager Navigation
@inject ApiService Api
@inject LanguageService Language

<PageTitle>VoiceChat</PageTitle>

<div class="dashboard">

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="brand">
            <div class="brand-icon">V</div>
            <span>VoiceChat</span>
        </div>

        <nav class="navigation">
            <span class="nav-label">@T("Dashboard")</span>

            <a class="nav-item active" href="/homePage">
                <span>▦</span>
                @T("Rooms")
            </a>

            <a class="nav-item" href="/profile">
                <span>⚙</span>
                @T("Settings")
            </a>
        </nav>

        <div class="sidebar-bottom">
            <a class="nav-item" href="/profile">
                <span>👤</span>
                @T("Profile")
            </a>
        </div>

    </aside>

    <!-- MAIN CONTENT -->
    <main class="main-content">

        <header class="topbar">
            <div>
                <span class="breadcrumb">VoiceChat / @T("Dashboard")</span>
            </div>
            <!-- CREATE ROOM MODAL -->
            <button class="create-room-btn" @onclick="OpenCreateRoomModal">
                <span>＋</span> @T("CreateRoom")
            </button>
            <div class="topbar-actions">

                <select class="language-select" value="@Language.CurrentLanguage" @onchange="ChangeLanguage">

                    <option value="en">🇬🇧 English</option>
                    <option value="uz">🇺🇿 O'zbekcha</option>
                    <option value="ru">🇷🇺 Русский</option>

                </select>

                <a href="/profile" class="profile-button">
                    👤
                </a>

            </div>
        </header>

        <section class="welcome-section">

            <div>
                <span class="eyebrow">VOICECHAT</span>

                <h1>@T("Welcome")</h1>

                <p>@T("Subtitle")</p>
            </div>


        </section>

        <section class="rooms-section">

            <div class="section-header">

                <div>
                    <h2>@T("YourRooms")</h2>
                    <p>@rooms.Count rooms available</p>
                </div>

                <button class="refresh-button" @onclick="LoadRooms" disabled="@loading">
                    ↻ @T("Refresh")
                </button>

            </div>

            @if (loading)
            {
                <div class="empty-state">
                    <div class="loader"></div>
                    <p>@T("Loading")</p>
                </div>
            }
            else if (!string.IsNullOrEmpty(error))
            {
                <div class="error-state">
                    @error
                </div>
            }
            else if (rooms.Count == 0)
            {
                <div class="empty-state">

                    <div class="empty-icon">🎧</div>

                    <h3>@T("NoRooms")</h3>

                    <p>@T("NoRoomsDescription")</p>

                    <button class="create-button" @onclick="OpenCreateModal">
                        ＋ @T("CreateRoom")
                    </button>

                </div>
            }
            else
            {
                <div class="rooms-grid">

                    @foreach (var room in rooms)
                    {
                        <article class="room-card" @key="room.Id">

                            <div class="room-card-top">
                                <div class="room-icon">🎧</div>
                                <span class="room-status">● @T("RoomStatus")</span>
                            </div>

                            <h3>@room.Name</h3>

                            <p class="room-description">
                                @(string.IsNullOrWhiteSpace(room.Description)
                                    ? "No description"
                                    : room.Description)
                            </p>

                            <button class="join-button" @onclick="() => NavigateToRoom(room.Id)">
                                @T("Join") →
                            </button>

                        </article>
                    }

                </div>
            }

        </section>

    </main>

 

    @if (showCreateRoomModal)
    {
        <div class="modal-overlay" @onclick="CloseCreateRoomModal">

            <div class="room-modal" @onclick:stopPropagation="true">

                <div class="modal-header">
                    <h2>Create a Room</h2>

                    <button class="close-btn" @onclick="CloseCreateRoomModal">
                        &times;
                    </button>
                </div>

                <div class="modal-body">

                    <label>Room Name</label>
                    <input type="text" @bind="newRoomName" placeholder="Enter room name" />

                    <label>Description</label>
                    <textarea @bind="newRoomDescription" placeholder="Describe your room"></textarea>

                    @if (!string.IsNullOrEmpty(error))
                    {
                        <p class="error-message">@error</p>
                    }

                </div>

                <div class="modal-footer">

                    <button class="cancel-btn" @onclick="CloseCreateRoomModal">
                        Cancel
                    </button>

                    <button class="submit-btn" @onclick="CreateRoom" disabled="@creating">
                        @(creating ? "Creating..." : "Create Room")
                    </button>

                </div>

            </div>
        </div>
    }

</div>

@code {

    private bool showCreateRoomModal = false;

    private string newRoomName = "";
    private string newRoomDescription = "";

    private void OpenCreateRoomModal()
    {
        showCreateRoomModal = true;
    }

    private void CloseCreateRoomModal()
    {
        showCreateRoomModal = false;
    }

    private List<Room> rooms = new();

    private bool loading = true;
    private bool showCreateModal;
    private bool creating;

    private string? error;
    private string? createError;

    private string T(string key) => Language.Get(key);

    protected override async Task OnInitializedAsync()
    {
        Language.OnLanguageChanged += OnLanguageChanged;

        if (!await Api.ValidateSessionAsync())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadRooms();
    }

    private void OnLanguageChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void ChangeLanguage(ChangeEventArgs e)
    {
        if (e.Value is string language)
        {
            Language.SetLanguage(language);
        }
    }

    private async Task LoadRooms()
    {
        loading = true;
        error = null;

        try
        {
            rooms = await Api.GetRoomsAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private void OpenCreateModal()
    {
        newRoomName = "";
        newRoomDescription = "";
        createError = null;
        showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        showCreateModal = false;
    }

    private async Task CreateRoom()
    {
        if (string.IsNullOrWhiteSpace(newRoomName))
        {
            error = "Room name is required.";
            return;
        }

        try
        {
            creating = true;
            error = "";

            // Get the logged-in user's ID.
            string? token = Api.GetSessionToken();

            if (string.IsNullOrEmpty(token))
            {
                error = "Your session has expired. Please log in again.";
                return;
            }

            var currentUser = await Api.GetCurrentUserAsync(token);

            if (currentUser == null)
            {
                error = "Could not identify the current user.";
                return;
            }

            // Send the request to the backend.
            await Api.CreateRoomAsync(
                newRoomName.Trim(),
                currentUser.Id,
                newRoomDescription.Trim()
            );

            // Refresh the room list.
            await LoadRooms();

            // Reset and close the modal.
            newRoomName = "";
            newRoomDescription = "";
            showCreateRoomModal = false;
        }
        catch (Exception ex)
        {
            error = $"Room creation failed: {ex.Message}";
        }
        finally
        {
            creating = false;
        }
    }

    private void NavigateToRoom(int roomId)
    {
        Navigation.NavigateTo($"/room/{roomId}");
    }

    public void Dispose()
    {
        Language.OnLanguageChanged -= OnLanguageChanged;
    }
}