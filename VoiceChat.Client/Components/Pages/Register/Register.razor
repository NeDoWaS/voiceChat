@page "/register"
@using VoiceChat.Client.Models
@using Microsoft.AspNetCore.Components
@using VoiceChat.Client.Services
@using System.ComponentModel.DataAnnotations
@inject ApiService Api
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Register</PageTitle>

<div class="auth-container">
    <div class="auth-card">
        <h1>Create account</h1>
        <p class="subtitle">Create your VoiceChat account</p>

        <EditForm Model="@RegisterModel" OnValidSubmit="@RegisterUser" FormName="registerForm">
            <DataAnnotationsValidator />
            
            <ValidationSummary />

            <div class="form-group">
                <label>Name</label>
                <InputText @bind-Value="RegisterModel.Name" type="text" />
            </div>

            <div class="form-group">
                <label>Email</label>
                <InputText @bind-Value="RegisterModel.Email" type="email" />
            </div>

            <div class="form-group">
                <label>Password</label>
                <InputText @bind-Value="RegisterModel.Password" type="password" />
            </div>

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <p class="error">@ErrorMessage</p>
            }

            <button type="submit" disabled="@IsLoading">
                @(IsLoading ? "Creating account..." : "Register")
            </button>
        </EditForm>

        <p class="switch-page">
            Already have an account?
            <a href="/login">Login</a>
        </p>
    </div>
</div>

@code {
    private RegisterRequest RegisterModel { get; set; } = new();

    private string? ErrorMessage { get; set; }

    private bool IsLoading { get; set; }

    private async Task RegisterUser()
    {
        ErrorMessage = null;
        IsLoading = true;

        try
        {
            var response = await Api.RegisterUserAsync(RegisterModel.Name, RegisterModel.Email, RegisterModel.Password);
            
            Console.WriteLine($"API response: {response}");

            if (response)
            {
                Navigation.NavigateTo("/login");
            }
            else
            {
                ErrorMessage = "Registration failed.";
                Console.WriteLine("Registration failed. \nHere is the response: " + response);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = "Something went wrong.";
            Console.WriteLine("Registration failed. \nHere is the response: " + ex.Message);
        }
        finally
        {
            IsLoading = false;
        }
    }    
}
<style>
    .auth-container {
    min-height: 80vh;
    display: flex;
    justify-content: center;
    align-items: center;
}

.auth-card {
    width: 400px;
    padding: 32px;
    border-radius: 12px;
    background: #ffffff;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
}

.auth-card h1 {
    margin-bottom: 5px;
    text-align: center;
}

.subtitle {
    text-align: center;
    color: #777;
    margin-bottom: 25px;
}

.form-group {
    display: flex;
    flex-direction: column;
    margin-bottom: 18px;
}

.form-group label {
    margin-bottom: 6px;
    font-weight: 500;
}

.form-group input {
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 16px;
}

button {
    width: 100%;
    padding: 11px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-size: 16px;
}

button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.error {
    color: #d32f2f;
    margin-bottom: 15px;
}

.switch-page {
    text-align: center;
    margin-top: 20px;
}
</style>